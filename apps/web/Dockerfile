FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json* ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_BUSINESS_NAME
ARG NEXT_PUBLIC_BUSINESS_PHONE
ARG NEXT_PUBLIC_BUSINESS_ADDRESS
ARG NEXT_PUBLIC_BUSINESS_LATITUDE
ARG NEXT_PUBLIC_BUSINESS_LONGITUDE
ARG NEXT_PUBLIC_BUSINESS_OPENING_HOURS
ARG NEXT_PUBLIC_BUSINESS_PRICE_RANGE
ARG NEXT_PUBLIC_ZALO_OA_URL
ARG NEXT_PUBLIC_GOOGLE_MAPS_URL
ARG NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ARG NEXT_PUBLIC_GOOGLE_SEARCH_CONSOLE_VERIFICATION
ARG NEXT_PUBLIC_FACEBOOK_URL
ARG NEXT_PUBLIC_TIKTOK_URL
ARG NEXT_PUBLIC_YOUTUBE_URL
ARG NEXT_PUBLIC_FACEBOOK_MESSENGER_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_BUSINESS_NAME=$NEXT_PUBLIC_BUSINESS_NAME
ENV NEXT_PUBLIC_BUSINESS_PHONE=$NEXT_PUBLIC_BUSINESS_PHONE
ENV NEXT_PUBLIC_BUSINESS_ADDRESS=$NEXT_PUBLIC_BUSINESS_ADDRESS
ENV NEXT_PUBLIC_BUSINESS_LATITUDE=$NEXT_PUBLIC_BUSINESS_LATITUDE
ENV NEXT_PUBLIC_BUSINESS_LONGITUDE=$NEXT_PUBLIC_BUSINESS_LONGITUDE
ENV NEXT_PUBLIC_BUSINESS_OPENING_HOURS=$NEXT_PUBLIC_BUSINESS_OPENING_HOURS
ENV NEXT_PUBLIC_BUSINESS_PRICE_RANGE=$NEXT_PUBLIC_BUSINESS_PRICE_RANGE
ENV NEXT_PUBLIC_ZALO_OA_URL=$NEXT_PUBLIC_ZALO_OA_URL
ENV NEXT_PUBLIC_GOOGLE_MAPS_URL=$NEXT_PUBLIC_GOOGLE_MAPS_URL
ENV NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=$NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL
ENV NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=$NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ENV NEXT_PUBLIC_GOOGLE_SEARCH_CONSOLE_VERIFICATION=$NEXT_PUBLIC_GOOGLE_SEARCH_CONSOLE_VERIFICATION
ENV NEXT_PUBLIC_FACEBOOK_URL=$NEXT_PUBLIC_FACEBOOK_URL
ENV NEXT_PUBLIC_TIKTOK_URL=$NEXT_PUBLIC_TIKTOK_URL
ENV NEXT_PUBLIC_YOUTUBE_URL=$NEXT_PUBLIC_YOUTUBE_URL
ENV NEXT_PUBLIC_FACEBOOK_MESSENGER_URL=$NEXT_PUBLIC_FACEBOOK_MESSENGER_URL

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
RUN npm run build --workspace @minhnhat/web

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
