{
  "name": "dien-lanh-minh-nhat",
  "version": "0.1.0",
  "private": true,
  "description": "Local SEO and lead generation platform for DIEN LANH MINH NHAT.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @minhnhat/web",
    "dev:api": "npm run start:dev --workspace @minhnhat/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prisma:generate": "npm run prisma:generate --workspace @minhnhat/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @minhnhat/api"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "next": {
      ".": "15.5.18",
      "postcss": "8.5.10"
    },
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
