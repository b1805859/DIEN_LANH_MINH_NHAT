{
  "name": "dien-lanh-minh-nhat",
  "version": "0.1.0",
  "private": true,
  "description": "Local SEO and lead generation platform for DIEN LANH MINH NHAT.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @minhnhat/web",
    "dev:api": "npm run start:dev --workspace @minhnhat/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @minhnhat/web",
    "build:api": "npm run build --workspace @minhnhat/api",
    "validate:production": "node scripts/validate-production-env.mjs",
    "deploy": "npm run validate:production && docker compose up -d --build && docker compose restart nginx",
    "deploy:web": "npm run validate:production && docker compose up -d --build web && docker compose restart nginx",
    "deploy:api": "docker compose up -d --build api && docker compose restart nginx",
    "deploy:nginx": "docker compose up -d nginx && docker compose restart nginx",
    "docker:ps": "docker compose ps",
    "logs:web": "docker compose logs -f web",
    "logs:api": "docker compose logs -f api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prisma:generate": "npm run prisma:generate --workspace @minhnhat/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @minhnhat/api"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "form-data": "4.0.6",
    "next": {
      ".": "15.5.18",
      "postcss": "8.5.10"
    },
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
