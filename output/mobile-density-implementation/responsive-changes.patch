+++ apps/web/app/mobile-density.css
@@ -0,0 +1,125 @@
+/* Approved mobile composition. Desktop continues using the existing components. */
+.mn-mobile-only, .mn-disclosure-toggle, .mn-footer-toggle { display: none; }
+.mn-mobile-disclosure, .mn-disclosure-body { display: contents; }
+
+@media (max-width: 900px) {
+  .mn-mobile-only { display: inline; }
+  .mn-desktop-only, .mn-footer-desktop-label { display: none; }
+  .mn-site[data-home] .mn-home-content .mn-home-services-heading .mn-desktop-only { display: none; }
+  .mn-site[data-home] .mn-home-content { display: flex; flex-direction: column; }
+  /* Match the hydrated reading order while the server markup is being connected. */
+  .mn-site[data-home] .mn-home-services { order: 0; }
+  .mn-home-process-disclosure { order: 1; }
+  .mn-home-about-disclosure { order: 2; }
+  .mn-home-coverage-band { order: 3; }
+  .mn-home-projects { order: 4; }
+  .mn-site .mn-home-hero nav { display: none; }
+
